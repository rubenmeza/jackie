[node name="RulesText" type="RichTextLabel" parent="RulesPanel/RulesVBox"]
layout_mode = 2
custom_minimum_size = Vector2(600, 580)
bbcode_enabled = true
scroll_active = true
text = "[b]Goal:[/b] Get closer to 21 than the dealer without going over (busting).

[b]Card Values:[/b]
  • Number cards (2–10) = face value
  • J, Q, K = 10 points
  • Ace = 1 or 11, whichever helps most

[b]Actions:[/b]
  • [b]Hit[/b] — Draw one more card
  • [b]Stand[/b] — Keep your current hand
  • [b]Double[/b] — Double your bet and receive exactly one card

[b]Winning:[/b]
  • Beat the dealer's total → Win your bet (1×)
  • Blackjack (Ace + 10-value on first 2 cards) → Win 1.5×
  • Dealer busts (over 21) → You win
  • Tie (Push) → Bet is returned
  • You bust or dealer beats you → Lose your bet

[b]Dealer Rules:[/b]
  The dealer must hit until reaching 17 or higher.
  The dealer hits on a soft 17 (Ace + 6).

[b]Tip:[/b] Watch the hint bar at the bottom during play — it shows the recommended move based on basic strategy!"

[node name="CloseRulesButton" type="Button" parent="RulesPanel/RulesVBox"]
